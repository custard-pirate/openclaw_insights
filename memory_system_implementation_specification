## 8. Indexer — `indexer.py`

Handles chunking, embedding, and entity extraction. **Indexing (chunk + embed) never calls the LLM** — it is fast and has no external dependencies beyond fastembed. Entity extraction is a separate pass.

### 8.1 Key design decisions

- **Indexing and entity extraction are separate steps.** Inline entity extraction caused timeouts because the LLM server was busy serving agents. The two-step approach means the fast path (chunk+embed) always succeeds, and entity extraction runs when the LLM is idle.
- **Entity extraction batches 5 chunks per LLM call** with a configurable delay between calls (default 3s) to avoid contention.
- **Retry with exponential backoff** — 3 attempts per batch (10s, 20s, 40s waits), then abandons the run gracefully. Chunks stay at `has_entities=0` and are retried on the next scheduled run.
- **Mtime-based incremental updates** — files are skipped if their modification time hasn't changed.

### 8.2 Entity types and relationships

The LLM is prompted to extract the following:

| Node type | Examples |
|---|---|
| `Agent` | Zoe, Bob, Coder, Researcher, Creator, Planner, Administrator, Steve |
| `Task` | Specific named tasks or work items |
| `Concept` | Technical or domain concepts worth remembering |
| `Decision` | Decisions made (prefixed "Decision: ") |
| `Domain` | security, health, wealth, education, entertainment |
| `Person` | Named humans |

Relationship types: `ASSIGNED_TO`, `WORKS_ON`, `KNOWS_ABOUT`, `DECIDED`, `RELATES_TO`, `PRECEDES`, `MENTIONS`

### 8.3 Full source

```python
#!/usr/bin/env python3
"""
Memory indexer.

Usage:
  indexer.py                        Incremental update (skip unchanged files)
  indexer.py --full                 Re-index all files
  indexer.py --file PATH            Index a single file
  indexer.py --extract-entities     Qwen entity extraction on unprocessed chunks
  indexer.py --decay                Apply TTL decay to old daily logs
"""
import argparse
import glob as glob_module
import json
import re
import sys
import time
from pathlib import Path

import requests

sys.path.insert(0, str(Path(__file__).parent))
import memory as mem

ENTITY_PROMPT = """\
You are extracting structured entities from passages of an AI team's memory log.

{passages}

Return ONLY valid JSON in exactly this format — one entry per passage id:
{{
  "chunks": [
    {{
      "id": <passage_id>,
      "entities": [
        {{"type": "Agent|Task|Concept|Decision|Domain|Person", "name": "canonical name"}}
      ],
      "relationships": [
        {{"from": "name", "rel": "ASSIGNED_TO|WORKS_ON|KNOWS_ABOUT|DECIDED|RELATES_TO|PRECEDES|MENTIONS", "to": "name"}}
      ]
    }}
  ]
}}

Rules:
- Agent: Zoe, Bob, Coder, Researcher, Creator, Planner, Administrator, Steve
- Task: a specific task or work item with a clear name
- Concept: a technical or domain concept worth remembering
- Decision: prefix with "Decision: "
- Domain: security, health, wealth, education, entertainment
- Only extract what is explicitly mentioned; omit uncertain inferences
- Keep names short and canonical
- Use {{"entities": [], "relationships": []}} for a passage with nothing to extract\
"""


def chunk_markdown(file_path: str, chunk_size: int = 300) -> list[dict]:
    with open(file_path, encoding="utf-8", errors="replace") as f:
        lines = f.readlines()
    chunks, current_heading, current_lines, start_line = [], "", [], 0

    def flush(end_line):
        text = "".join(current_lines).strip()
        if not text:
            return
        words = text.split()
        for i in range(0, len(words), max(1, chunk_size)):
            piece = " ".join(words[i:i + chunk_size])
            if piece.strip():
                chunks.append({"file_path": file_path, "heading": current_heading,
                               "content": piece, "start_line": start_line, "end_line": end_line})

    for i, line in enumerate(lines):
        if re.match(r"^#{1,4} ", line):
            flush(i)
            current_heading = line.strip().lstrip("#").strip()
            current_lines, start_line = [], i + 1
        else:
            current_lines.append(line)
    flush(len(lines))
    return chunks


def index_file(file_path: str, conn, force: bool = False):
    file_path = str(Path(file_path).resolve())
    if not Path(file_path).exists():
        return
    mtime = Path(file_path).stat().st_mtime
    existing = conn.execute("SELECT mtime FROM file_index WHERE file_path=?", (file_path,)).fetchone()
    if existing and not force and abs(existing["mtime"] - mtime) < 0.5:
        print(f"  [skip] unchanged: {Path(file_path).name}")
        return
    print(f"  [index] {Path(file_path).name} ...", end=" ", flush=True)
    conn.execute(
        "UPDATE edges SET chunk_id=NULL WHERE chunk_id IN (SELECT id FROM chunks WHERE file_path=?)",
        (file_path,),
    )
    conn.execute("DELETE FROM chunks WHERE file_path=?", (file_path,))
    conn.commit()
    cfg = mem.load_config()
    chunks = chunk_markdown(file_path, cfg.get("chunk_size", 300))
    if not chunks:
        print("empty")
        return
    vecs = mem.embed_texts([c["content"] for c in chunks])
    for chunk, vec in zip(chunks, vecs):
        cur = conn.execute(
            "INSERT INTO chunks(file_path, heading, content, start_line, end_line, file_mtime, has_entities) VALUES (?,?,?,?,?,?,0)",
            (chunk["file_path"], chunk["heading"], chunk["content"],
             chunk["start_line"], chunk["end_line"], mtime),
        )
        conn.execute("INSERT INTO embeddings(chunk_id, vector) VALUES (?,?)", (cur.lastrowid, vec.tobytes()))
    conn.execute(
        "INSERT INTO file_index(file_path, mtime, chunk_count) VALUES (?,?,?) "
        "ON CONFLICT(file_path) DO UPDATE SET mtime=excluded.mtime, chunk_count=excluded.chunk_count, last_indexed=datetime('now')",
        (file_path, mtime, len(chunks)),
    )
    conn.commit()
    print(f"{len(chunks)} chunks")


def collect_files(cfg: dict) -> list[str]:
    files = []
    for pattern in cfg.get("memory_files", []):
        files.extend(glob_module.glob(pattern))
    for d in cfg.get("memory_dirs", []):
        for ext in ("*.md", "*.txt"):
            files.extend(glob_module.glob(str(Path(d) / ext)))
    return sorted(set(str(Path(f).resolve()) for f in files if Path(f).exists()))


def _call_qwen(prompt: str, timeout: int = 60):
    cfg = mem.load_config()
    for attempt in range(3):
        try:
            r = requests.post(
                f"{cfg['qwen_base_url']}/chat/completions",
                json={"model": mem.get_qwen_model(),
                      "messages": [{"role": "user", "content": prompt}],
                      "temperature": 0.0, "max_tokens": 1024},
                timeout=timeout,
            )
            r.raise_for_status()
            return r.json()["choices"][0]["message"]["content"].strip()
        except requests.exceptions.Timeout:
            wait = 10 * (2 ** attempt)
            print(f"    [retry {attempt+1}/3] timeout, waiting {wait}s...", file=sys.stderr)
            time.sleep(wait)
        except Exception as e:
            print(f"    [warn] Qwen call failed: {e}", file=sys.stderr)
            return None
    return None


def _store_entities(data: dict, chunk_id_map: dict, conn) -> int:
    cid = data.get("id")
    if cid not in chunk_id_map:
        return 0
    node_ids = {}
    for ent in data.get("entities", []):
        name = str(ent.get("name", "")).strip()
        etype = str(ent.get("type", "Concept")).strip()
        if not name:
            continue
        conn.execute("INSERT OR IGNORE INTO nodes(type, name) VALUES (?,?)", (etype, name))
        row = conn.execute("SELECT id FROM nodes WHERE type=? AND name=?", (etype, name)).fetchone()
        if row:
            node_ids[name] = row["id"]
    for rel in data.get("relationships", []):
        src, dst, rtype = str(rel.get("from","")).strip(), str(rel.get("to","")).strip(), str(rel.get("rel","RELATES_TO")).strip()
        if src in node_ids and dst in node_ids:
            conn.execute("INSERT INTO edges(src_id, rel, dst_id, chunk_id) VALUES (?,?,?,?)",
                         (node_ids[src], rtype, node_ids[dst], chunk_id_map[cid]))
    conn.execute("UPDATE chunks SET has_entities=1 WHERE id=?", (chunk_id_map[cid],))
    return len(data.get("entities", []))


def run_entity_extraction(conn, batch_size: int = 5, delay: float = 3.0):
    pending = conn.execute("SELECT id, content FROM chunks WHERE has_entities=0 ORDER BY id").fetchall()
    if not pending:
        print("  No chunks pending entity extraction.")
        return
    total, total_entities, processed = len(pending), 0, 0
    print(f"  Extracting entities from {total} chunks (batch={batch_size}, delay={delay}s)...")
    for batch_start in range(0, total, batch_size):
        batch = pending[batch_start:batch_start + batch_size]
        passages = "\n\n".join(
            f"Passage {i+1} (id: {row['id']}):\n---\n{row['content'][:800]}\n---"
            for i, row in enumerate(batch)
        )
        chunk_id_map = {i + 1: row["id"] for i, row in enumerate(batch)}
        raw = _call_qwen(ENTITY_PROMPT.format(passages=passages))
        if raw is None:
            print(f"    [skip] batch {batch_start//batch_size + 1} — LLM unavailable")
            break
        match = re.search(r"\{.*\}", raw, re.DOTALL)
        if match:
            try:
                result = json.loads(match.group())
                for chunk_data in result.get("chunks", []):
                    total_entities += _store_entities(chunk_data, chunk_id_map, conn)
                    processed += 1
                conn.commit()
            except Exception:
                for row in batch:
                    conn.execute("UPDATE chunks SET has_entities=1 WHERE id=?", (row["id"],))
                conn.commit()
        print(f"  [{min(batch_start + batch_size, total)}/{total}] +{total_entities} entities", flush=True)
        if batch_start + batch_size < total:
            time.sleep(delay)
    print(f"  Done. {total_entities} entities extracted from {processed} chunks.")


def apply_decay(conn):
    cfg = mem.load_config()
    ttl = cfg.get("ttl_days", 90)
    rows = conn.execute(
        "SELECT DISTINCT file_path FROM chunks WHERE date(indexed_at) < date('now', ? || ' days')",
        (f"-{ttl}",),
    ).fetchall()
    for row in rows:
        fp = row["file_path"]
        if re.search(r"/memory/\d{4}-\d{2}-\d{2}", fp):
            print(f"  [decay] {Path(fp).name}")
            conn.execute("DELETE FROM chunks WHERE file_path=?", (fp,))
    conn.commit()


def main():
    parser = argparse.ArgumentParser(description="OpenClaw memory indexer")
    parser.add_argument("--full", action="store_true")
    parser.add_argument("--file", default=None)
    parser.add_argument("--extract-entities", action="store_true")
    parser.add_argument("--batch-size", type=int, default=5)
    parser.add_argument("--delay", type=float, default=3.0)
    parser.add_argument("--decay", action="store_true")
    args = parser.parse_args()
    conn = mem.get_db()
    if args.decay:
        print("Applying TTL decay...")
        apply_decay(conn)
    elif args.extract_entities:
        run_entity_extraction(conn, batch_size=args.batch_size, delay=args.delay)
        s = mem.get_stats()
        print(f"Graph: {s['graph_nodes']} nodes, {s['graph_edges']} edges.")
    else:
        files = [args.file] if args.file else collect_files(mem.load_config())
        print(f"Indexing {len(files)} file(s)...")
        for fp in files:
            index_file(fp, conn, force=args.full)
        s = mem.get_stats()
        print(f"\nDone. {s['chunks']} chunks across {s['indexed_files']} files.")
        print("Run with --extract-entities to populate the knowledge graph.")
    conn.close()


if __name__ == "__main__":
    main()
```

