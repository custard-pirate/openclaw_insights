## 9. File Watcher — `watcher.py`

Optional daemon that watches memory directories and triggers incremental re-indexing on any file change. Suitable for development or installations where real-time indexing is preferred over the scheduled approach.

```python
#!/usr/bin/env python3
"""
Memory file watcher daemon.
Usage: watcher.py [--no-entities]
"""
import sys
import time
from pathlib import Path
from watchdog.events import FileSystemEventHandler
from watchdog.observers import Observer

sys.path.insert(0, str(Path(__file__).parent))
import indexer
import memory as mem

WATCHED_EXTENSIONS = {".md", ".txt"}


class MemoryHandler(FileSystemEventHandler):
    def __init__(self, do_entities: bool):
        self.do_entities = do_entities

    def _should_handle(self, path):
        return Path(path).suffix in WATCHED_EXTENSIONS

    def on_modified(self, event):
        if not event.is_directory and self._should_handle(event.src_path):
            self._reindex(event.src_path)

    def on_created(self, event):
        if not event.is_directory and self._should_handle(event.src_path):
            self._reindex(event.src_path)

    def _reindex(self, path):
        print(f"[watcher] {Path(path).name}", flush=True)
        try:
            conn = mem.get_db()
            indexer.index_file(path, conn, force=True)
            conn.close()
        except Exception as e:
            print(f"[watcher] error: {e}", flush=True)


def main():
    import argparse
    parser = argparse.ArgumentParser()
    parser.add_argument("--no-entities", action="store_true")
    args = parser.parse_args()
    cfg = mem.load_config()
    watch_dirs = list(cfg.get("memory_dirs", []))
    for fp in cfg.get("memory_files", []):
        parent = str(Path(fp).parent)
        if parent not in watch_dirs:
            watch_dirs.append(parent)
    handler = MemoryHandler(do_entities=not args.no_entities)
    observer = Observer()
    for d in watch_dirs:
        if Path(d).exists():
            observer.schedule(handler, d, recursive=False)
            print(f"[watcher] watching {d}")
    observer.start()
    print("[watcher] running — Ctrl-C to stop", flush=True)
    try:
        while True:
            time.sleep(5)
    except KeyboardInterrupt:
        observer.stop()
    observer.join()


if __name__ == "__main__":
    main()
```

