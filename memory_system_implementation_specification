## 7. Core Library — `memory.py`

This file serves as both an importable library and a CLI tool.

### 7.1 Full source

```python
#!/usr/bin/env python3
"""
Memory system core library and CLI.

Usage:
  memory.py search "query" [--agent AGENT] [--rerank] [--top N]
  memory.py facts "entity name" [--type TYPE]
  memory.py related "entity name"
  memory.py stats
"""
import argparse
import json
import os
import re
import sqlite3
import sys
from pathlib import Path
from typing import Optional

import faiss
import numpy as np
import requests

BASE_DIR = Path(__file__).parent
CONFIG_PATH = BASE_DIR / "config.json"

_config: Optional[dict] = None
_embed_model = None
_qwen_model_name: Optional[str] = None


def load_config() -> dict:
    global _config
    if _config is None:
        with open(CONFIG_PATH) as f:
            _config = json.load(f)
    return _config


def get_qwen_model() -> str:
    global _qwen_model_name
    if _qwen_model_name is None:
        cfg = load_config()
        if cfg.get("qwen_model", "auto") != "auto":
            _qwen_model_name = cfg["qwen_model"]
        else:
            r = requests.get(f"{cfg['qwen_base_url']}/models", timeout=5)
            r.raise_for_status()
            data = r.json().get("data", [])
            if not data:
                raise RuntimeError("No models available on Qwen server")
            _qwen_model_name = data[0]["id"]
    return _qwen_model_name


def get_embed_model():
    global _embed_model
    if _embed_model is None:
        from fastembed import TextEmbedding
        cfg = load_config()
        _embed_model = TextEmbedding(cfg.get("embedding_model", "BAAI/bge-small-en-v1.5"))
    return _embed_model


def embed_texts(texts: list[str]) -> np.ndarray:
    model = get_embed_model()
    vecs = np.array(list(model.embed(texts)), dtype=np.float32)
    faiss.normalize_L2(vecs)
    return vecs


def get_db() -> sqlite3.Connection:
    cfg = load_config()
    db_path = Path(cfg["db_path"])
    db_path.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(db_path))
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA foreign_keys=ON")
    _init_schema(conn)
    return conn


def _init_schema(conn: sqlite3.Connection):
    conn.executescript("""
        CREATE TABLE IF NOT EXISTS chunks (
            id           INTEGER PRIMARY KEY,
            file_path    TEXT NOT NULL,
            heading      TEXT DEFAULT '',
            content      TEXT NOT NULL,
            start_line   INTEGER DEFAULT 0,
            end_line     INTEGER DEFAULT 0,
            file_mtime   REAL,
            has_entities INTEGER DEFAULT 0,
            indexed_at   TEXT DEFAULT (datetime('now'))
        );
        CREATE VIRTUAL TABLE IF NOT EXISTS chunks_fts USING fts5(
            content, heading, content=chunks, content_rowid=id
        );
        CREATE TRIGGER IF NOT EXISTS chunks_ai AFTER INSERT ON chunks BEGIN
            INSERT INTO chunks_fts(rowid, content, heading)
            VALUES (new.id, new.content, new.heading);
        END;
        CREATE TRIGGER IF NOT EXISTS chunks_ad AFTER DELETE ON chunks BEGIN
            INSERT INTO chunks_fts(chunks_fts, rowid, content, heading)
            VALUES ('delete', old.id, old.content, old.heading);
        END;
        CREATE TABLE IF NOT EXISTS embeddings (
            chunk_id INTEGER PRIMARY KEY REFERENCES chunks(id) ON DELETE CASCADE,
            vector   BLOB NOT NULL
        );
        CREATE TABLE IF NOT EXISTS nodes (
            id INTEGER PRIMARY KEY, type TEXT NOT NULL, name TEXT NOT NULL,
            attributes TEXT DEFAULT '{}', created_at TEXT DEFAULT (datetime('now')),
            UNIQUE(type, name)
        );
        CREATE TABLE IF NOT EXISTS edges (
            id INTEGER PRIMARY KEY, src_id INTEGER REFERENCES nodes(id),
            rel TEXT NOT NULL, dst_id INTEGER REFERENCES nodes(id),
            chunk_id INTEGER REFERENCES chunks(id) ON DELETE SET NULL,
            created_at TEXT DEFAULT (datetime('now'))
        );
        CREATE TABLE IF NOT EXISTS file_index (
            file_path TEXT PRIMARY KEY, mtime REAL, chunk_count INTEGER DEFAULT 0,
            last_indexed TEXT DEFAULT (datetime('now'))
        );
        CREATE TABLE IF NOT EXISTS audit_log (
            id INTEGER PRIMARY KEY, operation TEXT NOT NULL, agent_id TEXT,
            query TEXT, result_count INTEGER, ts TEXT DEFAULT (datetime('now'))
        );
    """)
    try:
        conn.execute("ALTER TABLE chunks ADD COLUMN has_entities INTEGER DEFAULT 0")
    except Exception:
        pass
    conn.commit()


def build_faiss_index(conn: sqlite3.Connection) -> tuple:
    rows = conn.execute(
        "SELECT chunk_id, vector FROM embeddings ORDER BY chunk_id"
    ).fetchall()
    if not rows:
        return faiss.IndexFlatIP(384), []
    ids = [r["chunk_id"] for r in rows]
    vecs = np.stack([np.frombuffer(r["vector"], dtype=np.float32) for r in rows])
    index = faiss.IndexFlatIP(vecs.shape[1])
    index.add(vecs)
    return index, ids


def search(
    query: str,
    top_k: Optional[int] = None,
    rerank: bool = False,
    agent_id: Optional[str] = None,
) -> list[dict]:
    cfg = load_config()
    k_fts = cfg.get("top_k_fts", 20)
    k_vec = cfg.get("top_k_vector", 20)
    k_final = top_k or cfg.get("top_k_final", 5)

    conn = get_db()
    _audit(conn, "search", agent_id, query)

    q_vec = embed_texts([query])
    index, chunk_ids = build_faiss_index(conn)
    vector_hits: dict[int, float] = {}
    if chunk_ids:
        scores, positions = index.search(q_vec, min(k_vec, len(chunk_ids)))
        for score, pos in zip(scores[0], positions[0]):
            if pos >= 0:
                vector_hits[chunk_ids[pos]] = float(score)

    fts_hits: dict[int, float] = {}
    safe_query = re.sub(r'[^\w\s]', ' ', query).strip()
    if safe_query:
        try:
            rows = conn.execute(
                "SELECT rowid, rank FROM chunks_fts WHERE chunks_fts MATCH ? ORDER BY rank LIMIT ?",
                (safe_query, k_fts),
            ).fetchall()
            max_rank = max((abs(r["rank"]) for r in rows), default=1.0) or 1.0
            for r in rows:
                fts_hits[r["rowid"]] = 1.0 - abs(r["rank"]) / max_rank
        except sqlite3.OperationalError:
            pass

    all_ids = set(vector_hits) | set(fts_hits)
    scored = []
    for cid in all_ids:
        score = vector_hits.get(cid, 0.0) * 0.6 + fts_hits.get(cid, 0.0) * 0.4
        scored.append((score, cid))
    scored.sort(reverse=True)
    candidate_ids = [cid for _, cid in scored[:max(k_final * 4, 20)]]

    if not candidate_ids:
        return []

    placeholders = ",".join("?" * len(candidate_ids))
    rows = conn.execute(
        f"SELECT id, file_path, heading, content, start_line FROM chunks WHERE id IN ({placeholders})",
        candidate_ids,
    ).fetchall()
    chunk_map = {r["id"]: dict(r) for r in rows}
    candidates = [chunk_map[cid] for cid in candidate_ids if cid in chunk_map]

    if rerank and candidates:
        candidates = _qwen_rerank(query, candidates, k_final)
    else:
        candidates = candidates[:k_final]

    _audit(conn, "search_result", agent_id, query, len(candidates))
    conn.close()
    return candidates


def _qwen_rerank(query: str, candidates: list[dict], top_k: int) -> list[dict]:
    numbered = "\n".join(
        f"[{i+1}] ({Path(c['file_path']).name} | {c['heading']})\n{c['content'][:300]}"
        for i, c in enumerate(candidates)
    )
    prompt = (
        f'Query: "{query}"\n\nCandidates:\n{numbered}\n\n'
        f"Return ONLY a JSON array of candidate numbers ranked by relevance "
        f"(most relevant first). Top {top_k} only."
    )
    try:
        cfg = load_config()
        r = requests.post(
            f"{cfg['qwen_base_url']}/chat/completions",
            json={"model": get_qwen_model(), "messages": [{"role": "user", "content": prompt}],
                  "temperature": 0.0, "max_tokens": 64},
            timeout=15,
        )
        r.raise_for_status()
        text = r.json()["choices"][0]["message"]["content"].strip()
        match = re.search(r'\[[\d,\s]+\]', text)
        if match:
            order = json.loads(match.group())
            reranked, seen = [], set()
            for n in order:
                idx = int(n) - 1
                if 0 <= idx < len(candidates) and idx not in seen:
                    reranked.append(candidates[idx])
                    seen.add(idx)
                if len(reranked) >= top_k:
                    break
            return reranked or candidates[:top_k]
    except Exception:
        pass
    return candidates[:top_k]


def get_facts(entity_name: str, entity_type: Optional[str] = None) -> list[dict]:
    conn = get_db()
    _audit(conn, "facts", None, entity_name)
    if entity_type:
        node = conn.execute(
            "SELECT id, type, name FROM nodes WHERE name=? AND type=?", (entity_name, entity_type)
        ).fetchone()
    else:
        node = conn.execute(
            "SELECT id, type, name FROM nodes WHERE name=?", (entity_name,)
        ).fetchone()
    if not node:
        conn.close()
        return []
    edges = conn.execute(
        """
        SELECT e.rel, n_dst.type AS dst_type, n_dst.name AS dst_name, c.file_path, c.heading
        FROM edges e JOIN nodes n_dst ON n_dst.id = e.dst_id
        LEFT JOIN chunks c ON c.id = e.chunk_id WHERE e.src_id = ?
        UNION ALL
        SELECT e.rel, n_src.type AS src_type, n_src.name AS src_name, c.file_path, c.heading
        FROM edges e JOIN nodes n_src ON n_src.id = e.src_id
        LEFT JOIN chunks c ON c.id = e.chunk_id WHERE e.dst_id = ?
        """,
        (node["id"], node["id"]),
    ).fetchall()
    conn.close()
    return [dict(e) for e in edges]


def get_related(entity_name: str) -> list[dict]:
    conn = get_db()
    _audit(conn, "related", None, entity_name)
    node = conn.execute("SELECT id FROM nodes WHERE name=?", (entity_name,)).fetchone()
    if not node:
        conn.close()
        return []
    rows = conn.execute(
        """
        SELECT DISTINCT n.type, n.name FROM edges e
        JOIN nodes n ON n.id IN (e.src_id, e.dst_id)
        WHERE (e.src_id = ? OR e.dst_id = ?) AND n.id != ?
        ORDER BY n.type, n.name
        """,
        (node["id"], node["id"], node["id"]),
    ).fetchall()
    conn.close()
    return [dict(r) for r in rows]


def get_stats() -> dict:
    conn = get_db()
    chunks = conn.execute("SELECT COUNT(*) FROM chunks").fetchone()[0]
    files = conn.execute("SELECT COUNT(*) FROM file_index").fetchone()[0]
    nodes = conn.execute("SELECT COUNT(*) FROM nodes").fetchone()[0]
    edges = conn.execute("SELECT COUNT(*) FROM edges").fetchone()[0]
    node_types = conn.execute(
        "SELECT type, COUNT(*) as n FROM nodes GROUP BY type ORDER BY n DESC"
    ).fetchall()
    conn.close()
    return {"chunks": chunks, "indexed_files": files, "graph_nodes": nodes,
            "graph_edges": edges, "node_types": {r["type"]: r["n"] for r in node_types}}


def _audit(conn, operation, agent_id=None, query=None, result_count=None):
    try:
        conn.execute(
            "INSERT INTO audit_log(operation, agent_id, query, result_count) VALUES (?,?,?,?)",
            (operation, agent_id, query, result_count),
        )
        conn.commit()
    except Exception:
        pass


def main():
    parser = argparse.ArgumentParser(description="OpenClaw memory system")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_search = sub.add_parser("search")
    p_search.add_argument("query")
    p_search.add_argument("--agent", default=None)
    p_search.add_argument("--rerank", action="store_true")
    p_search.add_argument("--top", type=int, default=None)
    p_search.add_argument("--json", action="store_true", dest="as_json")

    p_facts = sub.add_parser("facts")
    p_facts.add_argument("entity")
    p_facts.add_argument("--type", default=None)

    p_related = sub.add_parser("related")
    p_related.add_argument("entity")

    sub.add_parser("stats")

    args = parser.parse_args()

    if args.cmd == "search":
        results = search(args.query, top_k=args.top, rerank=args.rerank, agent_id=args.agent)
        if args.as_json:
            print(json.dumps(results, indent=2))
        elif results:
            for i, r in enumerate(results):
                source = Path(r['file_path']).name
                if r.get('heading'):
                    source += f" › {r['heading']}"
                if r.get('start_line'):
                    source += f" (line {r['start_line']})"
                print(f"[{i+1}] {source}\n{r['content']}\n")
        else:
            print("No results found.")
    elif args.cmd == "facts":
        facts = get_facts(args.entity, args.type)
        if facts:
            for f in facts:
                print(f"  {f['rel']}  →  {f.get('dst_name') or f.get('src_name')} ({f.get('dst_type') or f.get('src_type')})")
        else:
            print(f"No facts found for '{args.entity}'.")
    elif args.cmd == "related":
        related = get_related(args.entity)
        if related:
            for r in related:
                print(f"  [{r['type']}] {r['name']}")
        else:
            print(f"No related entities found for '{args.entity}'.")
    elif args.cmd == "stats":
        s = get_stats()
        print(f"Indexed files : {s['indexed_files']}")
        print(f"Chunks        : {s['chunks']}")
        print(f"Graph nodes   : {s['graph_nodes']}  (edges: {s['graph_edges']})")
        for t, n in s["node_types"].items():
            print(f"  {t:12s}: {n}")


if __name__ == "__main__":
    main()
```

