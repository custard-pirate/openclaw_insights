## 6. SQLite Schema

All state is in a single SQLite database. The schema is created automatically on first connection.

```sql
-- Text chunks from memory files
CREATE TABLE chunks (
    id           INTEGER PRIMARY KEY,
    file_path    TEXT NOT NULL,
    heading      TEXT DEFAULT '',
    content      TEXT NOT NULL,
    start_line   INTEGER DEFAULT 0,
    end_line     INTEGER DEFAULT 0,
    file_mtime   REAL,
    has_entities INTEGER DEFAULT 0,   -- 0=pending, 1=done
    indexed_at   TEXT DEFAULT (datetime('now'))
);

-- FTS5 virtual table — kept in sync with chunks via triggers
CREATE VIRTUAL TABLE chunks_fts USING fts5(
    content,
    heading,
    content=chunks,
    content_rowid=id
);

CREATE TRIGGER chunks_ai AFTER INSERT ON chunks BEGIN
    INSERT INTO chunks_fts(rowid, content, heading)
    VALUES (new.id, new.content, new.heading);
END;

CREATE TRIGGER chunks_ad AFTER DELETE ON chunks BEGIN
    INSERT INTO chunks_fts(chunks_fts, rowid, content, heading)
    VALUES ('delete', old.id, old.content, old.heading);
END;

-- Embeddings stored as raw float32 blobs
CREATE TABLE embeddings (
    chunk_id INTEGER PRIMARY KEY REFERENCES chunks(id) ON DELETE CASCADE,
    vector   BLOB NOT NULL
);

-- Knowledge graph nodes
CREATE TABLE nodes (
    id         INTEGER PRIMARY KEY,
    type       TEXT NOT NULL,   -- Agent | Task | Concept | Decision | Domain | Person
    name       TEXT NOT NULL,
    attributes TEXT DEFAULT '{}',
    created_at TEXT DEFAULT (datetime('now')),
    UNIQUE(type, name)
);

-- Knowledge graph edges
CREATE TABLE edges (
    id         INTEGER PRIMARY KEY,
    src_id     INTEGER REFERENCES nodes(id),
    rel        TEXT NOT NULL,   -- ASSIGNED_TO | WORKS_ON | KNOWS_ABOUT | DECIDED | RELATES_TO | PRECEDES | MENTIONS
    dst_id     INTEGER REFERENCES nodes(id),
    chunk_id   INTEGER REFERENCES chunks(id) ON DELETE SET NULL,
    created_at TEXT DEFAULT (datetime('now'))
);

-- Tracks which files have been indexed and their last-seen mtime
CREATE TABLE file_index (
    file_path    TEXT PRIMARY KEY,
    mtime        REAL,
    chunk_count  INTEGER DEFAULT 0,
    last_indexed TEXT DEFAULT (datetime('now'))
);

-- Append-only audit log
CREATE TABLE audit_log (
    id           INTEGER PRIMARY KEY,
    operation    TEXT NOT NULL,   -- search | search_result | facts | related
    agent_id     TEXT,
    query        TEXT,
    result_count INTEGER,
    ts           TEXT DEFAULT (datetime('now'))
);
```

**Migration note:** If the database already exists without the `has_entities` column, `_init_schema` applies a migration:
```python
try:
    conn.execute("ALTER TABLE chunks ADD COLUMN has_entities INTEGER DEFAULT 0")
    conn.commit()
except Exception:
    pass  # column already exists
```

